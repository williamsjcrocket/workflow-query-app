import { spawnSync } from "child_process";

function decryptPassword(): string {
  const encrypted = process.env.DB_PASSWORD_ENCRYPTED;
  if (!encrypted) return process.env.DB_PASSWORD ?? "";

  const result = spawnSync(
    "powershell.exe",
    [
      "-NoProfile",
      "-NonInteractive",
      "-Command",
      "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8; Add-Type -AssemblyName System.Security; [System.Text.Encoding]::UTF8.GetString([System.Security.Cryptography.ProtectedData]::Unprotect([System.Convert]::FromBase64String($env:ENCRYPTED_PW), $null, [System.Security.Cryptography.DataProtectionScope]::CurrentUser))"
    ],
    {
      env: { ...process.env, ENCRYPTED_PW: encrypted },
      encoding: "utf8",
    }
  );

  if (result.error) throw result.error;
  if (result.status !== 0) {
    throw new Error(`DPAPI decrypt failed: ${result.stderr?.trim() || "unknown stderr"}`);
  }

  return result.stdout.replace(/\r?\n$/, "");
}

const decrypted = decryptPassword();
const plain = process.env.DB_PASSWORD_COMPARE ?? "";

console.log("Decrypted length:", decrypted.length);
if (plain) {
  console.log("Compare length:", plain.length);
  console.log("Exact match:", decrypted === plain);
  console.log(
    "Char codes:",
    decrypted.split("").map((c) => c.charCodeAt(0))
  );
  console.log(
    "Compare codes:",
    plain.split("").map((c) => c.charCodeAt(0))
  );
}

export const dbPassword = decrypted;